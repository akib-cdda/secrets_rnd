{
  // Cloudflare Workers config for the secrets_rnd demo
  // 2 envs (dev, prod), each with own Worker name, vars, route, and CF-stored secrets
  // Secrets (SECRET_VALUE) are NOT declared here — they are pushed at deploy time
  // by the GitHub Action via `wrangler secret bulk` from the chosen GH Environment
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "secrets-rnd",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-05-31",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "minify": true,
  "observability": {
    "enabled": true
  },
  "env": {
    "dev": {
      "name": "secrets-rnd-dev",
      "vars": {
        // build-time plaintext env var (NOT a secret) — used by page to identify which worker served it
        "APP_NAME": "secrets-rnd-dev"
      },
      "routes": [
        {
          "pattern": "dev.akib35.dev/*",
          "custom_domain": true
        }
      ]
    },
    "prod": {
      "name": "secrets-rnd-prod",
      "vars": {
        "APP_NAME": "secrets-rnd-prod"
      },
      "routes": [
        {
          "pattern": "prod.akib35.dev/*",
          "custom_domain": true
        }
      ]
    }
  }
}
